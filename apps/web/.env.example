# short.win web app configuration (FRONTEND.md §2.1). Copy to .env.local; never commit secrets —
# every VITE_* value is public (it is compiled into the bundle).
#
# Cluster: mainnet | devnet | localnet. The wallet chain is solana:<cluster>.
VITE_CLUSTER=localnet
# Solana JSON-RPC (HTTP) and its subscriptions endpoint (ws). A browser-facing RPC URL is public;
# use an origin-restricted key, never a secret one.
VITE_RPC_URL=http://127.0.0.1:8899
VITE_RPC_WS_URL=ws://127.0.0.1:8900
# The short.win indexer API (services/indexer, openapi.yaml) and its WebSocket.
VITE_INDEXER_URL=http://127.0.0.1:8080
VITE_INDEXER_WS_URL=ws://127.0.0.1:8080/v1/ws
# The protocol address lookup table (ARCH §6.4 A28; scripts/build-alt.sh). Empty: no ALT.
VITE_PROTOCOL_ALT=
# Priority fee ceiling in micro-lamports per CU (FRONTEND.md §5.6).
VITE_PRIORITY_FEE_MAX_MICROLAMPORTS=1000000
# TEST-ONLY: enable the mock venue adapter (the program's `test-venue` build; E2E only). Never set
# in a production build: the build refuses it unless VITE_CLUSTER=localnet.
VITE_ENABLE_TEST_VENUE=false
# Explorer link template; {sig} is replaced by the transaction signature.
VITE_EXPLORER_TX_URL=https://explorer.solana.com/tx/{sig}?cluster=custom&customUrl=http%3A%2F%2F127.0.0.1%3A8899
