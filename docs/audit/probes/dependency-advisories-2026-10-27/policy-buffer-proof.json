                "    fn run_on_buffers(",
                "        &mut self,",
                "        input: &[u8],",
                "        output: &mut [u8],",
                "    ) -> io::Result<Status> {",
                "        let mut input = InBuffer::around(input);",
                "        let mut output = OutBuffer::around(output);",
                "",
                "        let remaining = self.run(&mut input, &mut output)?;",
                "",
                "        Ok(Status {",
                "            remaining,",
                "            bytes_read: input.pos(),",
                "            bytes_written: output.pos(),",
                "        })"
