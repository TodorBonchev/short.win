{
    "name": "@shortwin/math-wasm",
    "version": "0.1.0",
    "private": true,
    "description": "wasm-bindgen build (target web) of crates/shortwin-math-wasm for the frontend (ARCHITECTURE §1.2, §7.3). pkg/ is generated by `pnpm --filter @shortwin/math-wasm build` and not committed.",
    "license": "UNLICENSED",
    "type": "module",
    "exports": {
        ".": {
            "types": "./pkg/shortwin_math_wasm.d.ts",
            "default": "./pkg/shortwin_math_wasm.js"
        },
        "./wasm": "./pkg/shortwin_math_wasm_bg.wasm"
    },
    "files": [
        "pkg",
        "scripts"
    ],
    "scripts": {
        "build": "node scripts/build.mjs",
        "build:force": "node scripts/build.mjs --force"
    },
    "engines": {
        "node": ">=24.21.0"
    }
}
