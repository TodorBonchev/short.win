{
    "name": "@shortwin/client",
    "version": "0.1.0-next.0",
    "description": "TypeScript client for the short.win Solana program, built on @solana/kit: typed instruction builders, account and event decoders, PDA helpers and error codes. Generated by Codama from the program IDL.",
    "keywords": [
        "solana",
        "short.win",
        "shortwin",
        "anchor",
        "codama",
        "solana-kit",
        "client"
    ],
    "homepage": "https://github.com/TodorBonchev/short.win/tree/main/clients/js#readme",
    "bugs": {
        "url": "https://github.com/TodorBonchev/short.win/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TodorBonchev/short.win.git",
        "directory": "clients/js"
    },
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "@shortwin/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./idl": "./idl/shortwin.json",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "idl"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "prepare": "pnpm run build",
        "prepack": "npm run build",
        "idl:sync": "node scripts/sync-idl.mjs",
        "generate": "codama run js --config ../../codama.json",
        "typecheck": "tsc -p tsconfig.json",
        "test": "node --test test/*.test.ts",
        "check": "pnpm run typecheck && pnpm run test"
    },
    "peerDependencies": {
        "@solana/kit": "^8.3.0"
    },
    "devDependencies": {
        "@solana/kit": "8.3.0",
        "@codama/nodes-from-anchor": "1.5.6",
        "@codama/renderers-js": "2.5.0",
        "@types/node": "24.19.0",
        "codama": "1.11.0",
        "typescript": "5.9.3"
    },
    "engines": {
        "node": ">=20.18.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
